{
  "name": "seedrpool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node --input-type=module -e \"import {cpSync,mkdirSync} from 'node:fs'; mkdirSync('dist/admin',{recursive:true}); cpSync('src/admin/client.js','dist/admin/client.js');\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "24.0.1",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
